spring.application.name=wealth-wellness-hub
server.port=8080
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Groq API key
groq.api.key=${GROQ_API_KEY}

# H2 Database (dev) — swap datasource below for PostgreSQL in prod
spring.datasource.url=jdbc:h2:file:./ventura-db
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=update
spring.h2.console.enabled=true

# JWT
jwt.secret=ventura-super-secret-key-change-this-in-production-min-32-chars
jwt.expiration=86400000